# Copy to secrets.yaml only if you do not already have one. Never publish secrets.yaml.
wifi_ssid: "YOUR_WIFI_NAME"
wifi_password: "YOUR_WIFI_PASSWORD"
# Replace with your existing device key or generate a unique 32-byte base64 key.
tracer_api_key: "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA="
paw_web_username: "pawpower"
paw_web_password: "CHANGE_THIS_PASSWORD"
# Generate separate, unique API keys before installation.
pawpower_api_key: "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA="
display_api_key: "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA="
# Dummy cloud settings can stay unchanged with Cloud Uploads Off.
pawpower_server_url: "https://example.invalid"
pawpower_upload_token: "DUMMY_NOT_A_REAL_TOKEN_0000000000000000000000"
tracer_upload_token: "DUMMY_NOT_A_REAL_TOKEN_0000000000000000000000"
