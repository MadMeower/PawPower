# PAW POWER -- EXAMPLE ONLY; contains no real credentials.
# Copy to secrets.yaml beside PawPower.yaml, then replace ALL values.
# Keep your populated secrets.yaml private. Do not include it in shared ZIPs.
wifi_ssid: "REPLACE_WITH_YOUR_WIFI_NAME"
wifi_password: "REPLACE_WITH_YOUR_WIFI_PASSWORD"
# Generate a UNIQUE Base64-encoded 32-byte ESPHome encryption key.
# The placeholder below is intentionally invalid and will not compile.
shunt_api_key: "REPLACE_WITH_UNIQUE_BASE64_32_BYTE_KEY"
paw_web_username: "REPLACE_WITH_YOUR_USERNAME"
paw_web_password: "REPLACE_WITH_LONG_UNIQUE_PASSWORD"
